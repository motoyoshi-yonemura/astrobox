---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { excerpt } from '../../lib/excerpt';

export const prerender = true;

export async function getStaticPaths({ paginate }) {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	return paginate(posts, { pageSize: 4 });
}

const { page } = Astro.props;
---

<Layout title="ブログ | astrobox">
	<div class="container mt-4">
		<h1>ブログ記事一覧</h1>
		<div class="row">
			{page.data.map((post) => (
				<div class="col-md-4 mb-3">
					<div class="card">
						<div class="card-body">
							<h5 class="card-title">{post.data.title}</h5>
							<p class="card-text">{excerpt(post.body ?? '')}</p>
							<div class="mb-2">
								{post.data.tags.map((tag) => (
									<a href={`/blog/tags/${tag}`} class="badge text-bg-secondary text-decoration-none me-1">{tag}</a>
								))}
							</div>
							<a href={`/blog/${post.id}`} class="btn btn-primary">読む</a>
						</div>
					</div>
				</div>
			))}
		</div>

		<nav>
			<ul class="pagination">
				{page.url.prev && <li class="page-item"><a class="page-link" href={page.url.prev}>前へ</a></li>}
				{page.url.next && <li class="page-item"><a class="page-link" href={page.url.next}>次へ</a></li>}
			</ul>
		</nav>
	</div>
</Layout>
